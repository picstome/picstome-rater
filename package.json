{
  "name": "picstome-rater",
  "version": "1.1.0",
  "description": "Desktop app to apply star ratings from Picstome links",
  "main": "main.js",
  "author": "Picstome",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win --arm64 --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.picstome.rater",
    "productName": "Picstome Rater",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Picstome Rater",
        "schemes": [
          "picstome"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "picstome",
      "repo": "picstome-rater"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.photography",
      "artifactName": "Picstome.Rater-${version}-${arch}.dmg",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Picstome.Rater.Setup.${version}.exe",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Picstome Rater",
      "artifactName": "Picstome.Rater.Setup.${version}.exe"
    }
  }
}
